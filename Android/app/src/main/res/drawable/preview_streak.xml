<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="150dp" android:height="120dp" android:gravity="center">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/widget_preview_bg_streak" />
            <!-- Borde suave, casi invisible en oscuro pero delimita bien el blanco sobre blanco en la lista de widgets -->
            <stroke android:width="1dp" android:color="#1A000000" />
        </shape>
    </item>
    
    <!-- Ícono del fuego del widget real -->
    <item android:drawable="@drawable/ic_fire_streak"
          android:width="48dp" android:height="48dp" 
          android:gravity="center" android:bottom="8dp" />
          
    <!-- Simulación del texto del número de racha "12" -->
    <item android:width="36dp" android:height="16dp" android:gravity="center" android:top="40dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/widget_preview_text_primary" />
        </shape>
    </item>
</layer-list>
