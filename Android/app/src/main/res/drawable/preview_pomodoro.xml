<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Wide Base card -->
    <item android:width="240dp" android:height="140dp" android:gravity="center">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/widget_preview_bg_pomodoro" />
        </shape>
    </item>
    
    <!-- Timer Ring Outline -->
    <item android:width="80dp" android:height="80dp" android:gravity="top|center_horizontal" android:top="16dp">
        <shape android:shape="oval">
            <stroke android:width="8dp" android:color="@color/widget_preview_pomodoro_text" />
            <solid android:color="#00000000"/>
        </shape>
    </item>
    
    <!-- Timer Digits representation -->
     <item android:width="32dp" android:height="16dp" android:gravity="top|center_horizontal" android:top="48dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/widget_preview_pomodoro_text" />
        </shape>
    </item>
    
    <!-- Subtle indicator dots/dots under timer -->
    <item android:width="32dp" android:height="4dp" android:gravity="top|center_horizontal" android:top="70dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/widget_preview_pomodoro_accent" />
        </shape>
    </item>
    
    <!-- Play button -->
    <item android:width="44dp" android:height="44dp" android:gravity="bottom|center_horizontal" android:bottom="-6dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_preview_pomodoro_text" />
        </shape>
    </item>
</layer-list>
